worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;
events {}

# LLM API: the agent sends a placeholder key, the real one is added here.
http {
  access_log /dev/stdout;
  resolver __RESOLVER__ valid=60s;

  server {
    listen 8080;
    client_max_body_size 50m;

    location /v1/ {
      set $upstream https://api.anthropic.com;
      proxy_pass $upstream;
      proxy_ssl_server_name on;
      proxy_http_version 1.1;
      proxy_set_header Host api.anthropic.com;
      proxy_set_header Connection "";
      # Exactly one of these is non-empty; nginx drops a header set to "".
      proxy_set_header Authorization "__AUTHORIZATION__";
      proxy_set_header x-api-key "__X_API_KEY__";
      proxy_buffering off;
      proxy_read_timeout 600s;
    }

    location / { return 403; }
  }
}
